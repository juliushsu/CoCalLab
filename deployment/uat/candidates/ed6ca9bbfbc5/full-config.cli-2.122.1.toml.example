[functions.generate-report]
verify_jwt = true
entrypoint = "./functions/generate-report/index.ts"
[functions.export-report-snapshot]
verify_jwt = true
entrypoint = "./functions/export-report-snapshot/index.ts"
[functions.delete-uploaded-document]
verify_jwt = true
entrypoint = "./functions/delete-uploaded-document/index.ts"
[functions.analytics-emissions]
verify_jwt = true
