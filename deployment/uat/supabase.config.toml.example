# Existing Mock paths are preserved in source/bundle inventory, not enabled as real OCR/AI acceptance.
[functions.process-document]
enabled = false
verify_jwt = true
entrypoint = "./functions/process-document/index.ts"
[functions.classify-document]
enabled = false
verify_jwt = true
entrypoint = "./functions/classify-document/index.ts"
[functions.run-ai-audit]
enabled = false
verify_jwt = true
entrypoint = "./functions/run-ai-audit/index.ts"
